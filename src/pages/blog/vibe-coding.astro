---
import BlogLayout from '../../layouts/BlogLayout.astro';

export const meta = {
  title: 'וייב קודינג: המדריך המעשי בעברית לבניית מוצר אמיתי',
  description:
    'מה זה וייב קודינג (vibe coding), מה זה לא, ואיך בונים ככה מוצר שמחזיק בפרודקשן. התהליך, הכלים והמגבלות. קבעו פגישת אבחון חינם.',
  datePublished: '2026-08-01',
};

const dateLabel = meta.datePublished.split('-').reverse().join('.');

const faq = [
  {
    q: 'מה זה וייב קודינג במשפט אחד?',
    a: 'תהליך פיתוח שבו מתארים לסוכן AI מה רוצים בשפה חופשית, הסוכן כותב את הקוד, והאדם מכוון, בודק ומאשר כל שלב.',
  },
  {
    q: 'אפשר לבנות ככה מוצר אמיתי לפרודקשן?',
    a: 'כן. התנאי הוא תהליך הנדסי אמיתי מסביב לסוכן, עם בדיקות אוטומטיות, ביקורת קוד וגבולות ברורים. ככה בניתי את DeepClaw ואת AutoMate, ושתי המערכות רצות היום מול משתמשים אמיתיים.',
  },
  {
    q: 'צריך לדעת לתכנת כדי לעשות vibe coding?',
    a: 'לצעצוע של סוף שבוע, לא. למוצר שמחזיק, כן. מישהו צריך לקרוא את הקוד, לזהות החלטות גרועות ולקחת אחריות על הארכיטקטורה. הניסיון ההנדסי לא מתייתר, הוא משנה תפקיד.',
  },
  {
    q: 'באילו כלים משתמשים בפועל?',
    a: 'אני עובד עם Claude Code כסוכן הראשי, וסוכן ביקורת נפרד שעובר על כל שינוי לפני מיזוג. הכלי חשוב פחות מהתהליך: הגדרה ברורה, לולאות ביקורת ובדיקות שרצות על כל שינוי.',
  },
  {
    q: 'כמה זמן לוקח להגיע מרעיון למוצר עובד?',
    a: 'בסדרי גודל של שבועות, לא חודשים. גרסה ראשונה שאפשר להראות ללקוח נבנית מהר מאוד, ורוב הזמן אחר כך מושקע בהקשחה: אבטחה, מקרי קצה וניטור.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': 'https://www.benkalsky.co.il/blog/vibe-coding/#article',
      headline: 'וייב קודינג: המדריך המעשי בעברית',
      description: meta.description,
      inLanguage: 'he',
      datePublished: meta.datePublished,
      dateModified: meta.datePublished,
      mainEntityOfPage: 'https://www.benkalsky.co.il/blog/vibe-coding/',
      author: { '@id': 'https://www.benkalsky.co.il/#ben' },
      publisher: { '@id': 'https://www.benkalsky.co.il/#ben' },
    },
    {
      '@type': 'Person',
      '@id': 'https://www.benkalsky.co.il/#ben',
      name: 'Ben Kalsky',
      alternateName: 'בן קלסקי',
      jobTitle: 'Co-founder & CTO',
      url: 'https://www.benkalsky.co.il/',
      worksFor: { '@id': 'https://www.benkalsky.co.il/#digitizer' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.benkalsky.co.il/#digitizer',
      name: 'Digitizer',
      url: 'https://www.digitizer.co.il',
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://www.benkalsky.co.il/blog/vibe-coding/#faq',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
