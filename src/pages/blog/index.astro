---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { meta as vibeCoding } from './vibe-coding.astro';
import { meta as mcp } from './mcp.astro';
import { meta as aiAgents } from './ai-agents.astro';
import { meta as chatbotVsAgent } from './chatbot-vs-agent.astro';
import { meta as productionGap } from './ai-production-gap.astro';
import { meta as smallBizAutomation } from './small-business-automation.astro';
import { meta as buildAiAgent } from './build-ai-agent.astro';
import { meta as n8nVsMake } from './n8n-vs-make.astro';

const formatDate = (iso) => iso.split('-').reverse().join('.');

const posts = [
  {
    href: '/blog/n8n-vs-make/',
    title: 'מה זה n8n, ומתי כלי אוטומציה ויזואלי מפסיק להספיק',
    description:
      'ההבדלים שמרגישים בין n8n ל-Make אחרי חודש, למה השוואת מחיר לחודש שגויה, ושלושת הסימנים שהלוח הוויזואלי נשבר.',
    date: n8nVsMake.datePublished,
  },
  {
    href: '/blog/build-ai-agent/',
    title: 'סוכן AI לעסק: איך בונים אחד שמגיע לעבודה אמיתית',
    description:
      'מפרט בארבע שורות, שלוש רמות הרשאה, חיבור למערכות ופיילוט קצוב שמסתיים במספר. מה באמת מזמינים כשמזמינים סוכן.',
    date: buildAiAgent.datePublished,
  },
  {
    href: '/blog/small-business-automation/',
    title: 'אוטומציה לעסקים קטנים: מאיפה מתחילים',
    description:
      'איך בוחרים את התהליך הראשון לאוטומציה, ארבעת התנאים שהופכים אותו למשתלם, המועמדים הקבועים מהשטח, ומתי צריך סוכן במקום.',
    date: smallBizAutomation.datePublished,
  },
  {
    href: '/blog/ai-production-gap/',
    title: 'בינה מלאכותית לעסקים: למה הדמו מרשים והפרודקשן לא מגיע',
    description:
      'רוב פרויקטי ה-AI לא נכשלים בקול גדול, הם פשוט נעצרים אחרי הדמו. ארבע הסיבות האמיתיות, ותהליך שמגיע לפרודקשן בלי לשרוף שנה.',
    date: productionGap.datePublished,
  },
  {
    href: '/blog/chatbot-vs-agent/',
    title: 'צ\'אטבוט מול סוכן AI: ההבדל שמשנה כסף',
    description:
      'למה רוב הצ\'אטבוטים מאכזבים, מתי צ\'אטבוט בכל זאת מספיק, ומתי צריך סוכן שסוגר משימות. השוואה שורה מול שורה ודרך פשוטה להחליט.',
    date: chatbotVsAgent.datePublished,
  },
  {
    href: '/blog/ai-agents/',
    title: 'סוכן AI זה לא צ\'אטבוט: מה עובד דיגיטלי באמת עושה',
    description:
      'מה סוכני AI עושים בעסקים אמיתיים: מכירות, שירות, תפעול וידע. איך הם עובדים, אילו גבולות הם צריכים, ומתי מספיקה אוטומציה פשוטה.',
    date: aiAgents.datePublished,
  },
  {
    href: '/blog/mcp/',
    title: 'מה זה MCP ולמה כל עולם ה-AI אימץ אותו',
    description:
      'הסבר מעשי על Model Context Protocol: הבעיה שהוא פותר, איך הוא מחבר סוכני AI למערכות העסק, ודוגמאות חיות משרתים שפרסמתי בקוד פתוח.',
    date: mcp.datePublished,
  },
  {
    href: '/blog/vibe-coding/',
    title: 'Vibe Coding: המדריך המעשי בעברית',
    description:
      'מה זה vibe coding, מה זה לא, ואיך בונים ככה מוצר אמיתי שמחזיק בפרודקשן. התהליך המלא: הגדרה, סוכן שבונה, לולאות ביקורת ובדיקות.',
    date: vibeCoding.datePublished,
  },
];
---
<BlogLayout
  title="בלוג — בן קלסקי | AI, סוכנים ופיתוח אג'נטי בעברית"
  description="מדריכים מעשיים בעברית על יישום AI בעסקים: vibe coding, סוכנים אוטונומיים, MCP ואוטומציות. מניסיון של CTO שבונה מוצרים חיים."
  canonicalPath="/blog/"
>
  <div class="blog-head">
    <p class="eyebrow">מהשטח, לא מהמצגת</p>
    <h1>הבלוג <span class="h1-mark">בעברית</span></h1>
    <p>מדריכים מעשיים על AI, סוכנים ופיתוח אג'נטי. מה שאני לומד תוך כדי בנייה של מוצרים אמיתיים, בלי ז'רגון מיותר. כל מאמר כאן נכתב אחרי שהרצתי את הדבר עצמו בפרודקשן, ולא אחרי שקראתי עליו במקום אחר.</p>
  </div>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-card" href={post.href}>
          <time datetime={post.date}>{formatDate(post.date)}</time>
          <div>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <span class="read">לקריאה ←</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <section class="blog-topics">
    <h2>ארבעה נושאים שחוזרים כאן</h2>
    <p class="topics-lede">רוב השאלות שמגיעות אליי נופלות לאחת מארבע המשבצות האלה. אם אתם מחפשים מאיפה להתחיל, זו הדרך המהירה למצוא את המאמר הרלוונטי.</p>

    <div class="topic">
      <h3>סוכנים ואוטומציה</h3>
      <p>מתי מספיקה אוטומציה של תהליך אחד ומתי צריך משהו שמחליט לבד. <a href="/blog/ai-agents/">מה סוכן AI באמת עושה בעסק</a>, מה ההבדל מול <a href="/blog/chatbot-vs-agent/">צ'אטבוט רגיל</a>, ואיך בוחרים את התהליך הראשון לאוטומציה <a href="/blog/small-business-automation/">בעסק קטן</a>. הדגש כאן הוא על גבולות והרשאות, כי סוכן בלי גבולות לא עולה לאוויר בשום ארגון שפוי.</p>
    </div>

    <div class="topic">
      <h3>תשתית וחיבור למערכות</h3>
      <p>סוכן שווה בדיוק כמו הגישה שיש לו למידע של העסק. <a href="/blog/mcp/">‏MCP</a> הוא הפרוטוקול שהפך את החיבור הזה לסטנדרטי במקום אינטגרציה נקודתית לכל כלי. אני מפרסם שרתי MCP בקוד פתוח, וכותב כאן על מה שנשבר בשטח: הרשאות, תיעוד פעולות והפרדה בין קריאה לכתיבה.</p>
    </div>

    <div class="topic">
      <h3>פיתוח אג'נטי</h3>
      <p>איך נראית עבודה יומיומית עם סוכני קוד כשהמטרה היא מוצר שמחזיק בפרודקשן ולא דמו. <a href="/blog/vibe-coding/">המדריך המלא ל-vibe coding</a> מפרט את התהליך: הגדרה חדה, לולאות קצרות, ביקורת על כל שינוי ובדיקות אוטומטיות לפני עלייה לאוויר.</p>
    </div>

    <div class="topic">
      <h3>מהדמו לפרודקשן</h3>
      <p>החלק שאף אחד לא מתמחר. <a href="/blog/ai-production-gap/">למה פרויקטי AI נעצרים אחרי הדמו</a>: נתונים לא מסודרים, אין מדד הצלחה, ואין אדם אחד שאחראי על התוצאה. פה גם נמצאות השאלות של תמחור, החזר השקעה וניהול סיכון בפרויקט ראשון.</p>
    </div>

    <p class="topics-cta">רוצים לדבר על מקרה ספציפי אצלכם ולא על תיאוריה? <a href="https://www.benkalsky.co.il/#contact">השאירו פרטים</a> ואחזור אליכם.</p>
  </section>
</BlogLayout>
