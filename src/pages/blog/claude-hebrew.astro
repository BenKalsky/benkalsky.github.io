---
import BlogLayout from '../../layouts/BlogLayout.astro';

export const meta = {
  title: 'קלוד בעברית: מה עובד, מה נשבר, ואיך עוקפים | בן קלסקי',
  description:
    'עבודה עם Claude בעברית בפועל: איפה הפלט טוב, איפה RTL שובר מסמכים וקוד, ומתי כדאי לכתוב פרומפט באנגלית. קבעו פגישת אבחון חינם.',
  datePublished: '2026-08-06',
};

const dateLabel = meta.datePublished.split('-').reverse().join('.');

const faq = [
  {
    q: 'האם Claude עובד טוב בעברית?',
    a: 'לטקסט חופשי כן, ברמה שמספיקה לעבודה עסקית יומיומית. הבעיות מתחילות לא בשפה עצמה אלא בכל מקום שבו טקסט עברי נפגש עם מבנה: טבלאות, קוד, שמות קבצים ומסמכים מעורבים עברית ואנגלית. שם נדרשת עבודה ולא רק בקשה.',
  },
  {
    q: 'למה הפלט בעברית לפעמים יוצא הפוך או מבולגן?',
    a: 'ברוב המקרים זו לא הבנה שגויה של המודל אלא כיווניות. עברית נכתבת מימין לשמאל, ומחרוזות שמערבבות עברית עם אנגלית או עם מספרים מוצגות לפי כללי כיווניות שנקבעים בצד שמציג את הטקסט. אותו פלט בדיוק ייראה תקין בכלי אחד ושבור בשני.',
  },
  {
    q: 'עדיף לכתוב את הפרומפט בעברית או באנגלית?',
    a: 'בעברית כשהמשימה עצמה עברית ותלוית ניסוח, למשל כתיבת תוכן או מענה ללקוח. באנגלית כשהמשימה טכנית ומדויקת, למשל הגדרת מבנה נתונים או הוראות לקוד. אפשר גם לשלב: הוראות באנגלית ודוגמאות בעברית.',
  },
  {
    q: 'מה זה קלוד קוד ובמה הוא שונה מהצאט?',
    a: 'זו גרסה שרצה בטרמינל ובעורך הקוד ולא בדפדפן, ולכן היא רואה קבצים אמיתיים ומריצה פקודות במקום לענות בחלון נפרד. ההבדל המעשי הוא שאין העתקה והדבקה בין הכלי לעבודה, וזה בדיוק המקום שבו טקסט עברי נוטה להישבר.',
  },
  {
    q: 'האם אפשר לחבר את קלוד למערכות של העסק בעברית?',
    a: 'כן. השפה של הנתונים לא משנה את אופן החיבור, ובעברית זה עובד כמו באנגלית. מה שכן משתנה הוא הבדיקה: כדאי לוודא שהמערכת שבצד השני מקבלת ומחזירה עברית תקינה, כי הרבה מערכות ותיקות שומרות טקסט בקידוד שמעוות אותה.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': 'https://www.benkalsky.co.il/blog/claude-hebrew/#article',
      headline: 'קלוד בעברית: מה עובד, מה נשבר, ואיך עוקפים את זה',
      description: meta.description,
      inLanguage: 'he',
      datePublished: meta.datePublished,
      dateModified: meta.datePublished,
      mainEntityOfPage: 'https://www.benkalsky.co.il/blog/claude-hebrew/',
      author: { '@id': 'https://www.benkalsky.co.il/#ben' },
      publisher: { '@id': 'https://www.benkalsky.co.il/#digitizer' },
    },
    {
      '@type': 'Person',
      '@id': 'https://www.benkalsky.co.il/#ben',
      name: 'Ben Kalsky',
      alternateName: 'בן קלסקי',
      jobTitle: 'Co-founder & CTO',
      url: 'https://www.benkalsky.co.il/',
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.benkalsky.co.il/#digitizer',
      name: 'Digitizer',
      url: 'https://www.digitizer.co.il',
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://www.benkalsky.co.il/blog/claude-hebrew/#faq',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---
<BlogLayout
  title={meta.title}
  description={meta.description}
  canonicalPath="/blog/claude-hebrew/"
  ogType="article"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="prose">
    <p class="crumb"><a href="/blog/">בלוג</a> ← CLAUDE IN HEBREW</p>
    <h1>קלוד בעברית: מה עובד, מה נשבר, ואיך עוקפים את זה</h1>
    <p class="post-meta">
      <span>בן קלסקי · CTO, DIGITIZER</span>
      <time datetime={meta.datePublished}>{dateLabel}</time>
    </p>

    <p class="lede">רוב מי שמחפש <span class="kw">claude ai עברית</span> רוצה לדעת דבר אחד: האם זה עובד בשפה שלנו או שזה עוד כלי שנשבר ברגע שמכניסים לתוכו טקסט מימין לשמאל. התשובה הקצרה היא שהשפה עצמה בסדר גמור, והבעיות נמצאות במקום אחר לגמרי ממה שרוב האנשים מצפים. אני עובד ככה כל יום, וזה המקום שבו נתקלתי בקירות.</p>

    <h2>השפה עובדת. הכיווניות היא זו ששוברת</h2>
    <p>הטעות הראשונה שאני רואה היא לייחס כל בעיה בעברית לאיכות המודל. ברוב המקרים המודל הבין בדיוק מה שביקשתם והפיק טקסט תקין, ומה שהשתבש קרה אחריו.</p>
    <p>עברית נכתבת מימין לשמאל, ומחרוזת שמערבבת עברית עם אנגלית או עם מספרים מוצגת לפי כללי כיווניות שנקבעים בכלי שמציג אותה. אותו פלט עצמו ייראה מסודר במקום אחד ומבולגן במקום שני. <strong>כשמשהו נראה הפוך, בדקו קודם איפה הוא מוצג ורק אחר כך מה נכתב.</strong></p>

    <h2>שלושת המקומות שבהם זה באמת נשבר</h2>
    <p>אחרי מספיק שעות עבודה, הרשימה מצטמצמת לשלושה:</p>
    <ul>
      <li>טבלאות ורשימות ממוספרות. עמודה עברית לצד ערך באנגלית או מספר היא המקרה הקלאסי שבו הסדר על המסך אינו הסדר בנתונים.</li>
      <li>קוד עם מחרוזות עבריות. השורה נראית תקינה בעורך ונשברת בטרמינל, או להפך, וקשה לדעת מי מהשניים משקר.</li>
      <li>מסמכים מעורבים. פסקה בעברית עם שם מוצר באנגלית באמצע היא בדיוק המקום שבו סימני פיסוק קופצים לצד הלא נכון.</li>
    </ul>
    <p>לשלושתם יש מכנה משותף: אף אחד מהם אינו בעיה של הבנת השפה. כולם בעיות תצוגה או קידוד, וזו הסיבה שהן נפתרות בכלים ולא בניסוח טוב יותר של הבקשה.</p>

    <h2>מתי לכתוב את הפרומפט באנגלית דווקא</h2>
    <p>זו אולי ההמלצה הכי לא אינטואיטיבית כאן, והיא חוסכת הרבה זמן. כשהמשימה טכנית ומדויקת, כתיבת ההוראות באנגלית מקטינה אי הבנות, גם כשהפלט המבוקש הוא עברית.</p>
    <p>החלוקה שאני עובד לפיה פשוטה. משימה שתלויה בניסוח, למשל תוכן שיווקי או מענה ללקוח, נכתבת בעברית כי הניואנס הוא העבודה עצמה. משימה שתלויה במבנה, למשל הגדרת שדות או הוראות לקוד, נכתבת באנגלית. אפשר גם לערבב: הוראות באנגלית, דוגמאות בעברית.</p>
    <p>שימו לב שזו לא אמירה על איכות העברית של המודל. זו אמירה על כמה ניסוח טכני בעברית עמום יותר, בגלל שרוב מונחי המקצוע ממילא מגיעים מאנגלית.</p>

    <h2>קלוד קוד: אותו מודל, סביבה אחרת</h2>
    <p>החלק שמפתיע אנשים הוא שקלוד לא חייב לחיות בדפדפן. יש גרסה שרצה בטרמינל ובעורך הקוד, ולכן היא רואה קבצים אמיתיים ומריצה פקודות במקום להחזיר תשובה שצריך להעתיק.</p>
    <p>ההבדל המעשי לעבודה בעברית גדול מכפי שנשמע. כל העתקה והדבקה בין חלון לחלון היא הזדמנות לקידוד להשתבש, ולכן דווקא בעברית משתלם לצמצם את המעברים האלה. את ההיגיון הרחב יותר של עבודה מול קוד בעזרת מודל פירטתי <a href="/blog/vibe-coding/">כאן</a>.</p>

    <h2>לחבר את קלוד למערכות בעברית</h2>
    <p>ברגע שקלוד מחובר למקום שבו נמצא המידע האמיתי של העסק, הוא מפסיק להיות חלון צאט. החיבור עצמו לא מושפע משפת הנתונים, ובעברית הוא עובד כמו באנגלית. את הפרוטוקול שמאפשר את זה הסברתי <a href="/blog/mcp/">בנפרד</a>.</p>
    <p>מה שכן דורש תשומת לב הוא הצד השני. מערכות ותיקות רבות בישראל שומרות טקסט בקידוד שמעוות עברית, ואת זה מגלים בדרך כלל אחרי שהנתונים כבר זרמו. הבדיקה לוקחת דקות ומונעת ניקוי ידני ארוך.</p>

    <h2>מה זה אומר למי ששוקל להטמיע</h2>
    <p>אם השאלה שלכם היא האם אפשר לעבוד בעברית, התשובה היא כן, ולא נדרש לזה שום טריק. אם השאלה היא כמה עבודה יידרש כדי שזה ירוץ נקי בתוך תהליך אמיתי, התשובה תלויה כמעט לגמרי בכלים שמסביב ולא במודל.</p>
    <p>לכן כשאני בונה משהו שמדבר עברית, אני מקצה זמן לבדיקת התצוגה והקידוד מראש במקום להתפלא בהמשך. אותו היגיון של פיילוט קצוב שתיארתי <a href="/blog/build-ai-agent/">במדריך הבנייה</a> תקף כאן במלואו, פשוט עם סעיף בדיקה נוסף.</p>

    <h2>שאלות ותשובות</h2>
    <div class="qa">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <p class="cta-line">
      רוצים להטמיע כלי AI שעובד בעברית בתוך תהליך אמיתי?
      <a href="/#contact">קבעו פגישת אבחון חינם</a> ונראה מאיפה מתחילים.
    </p>
  </article>
</BlogLayout>
