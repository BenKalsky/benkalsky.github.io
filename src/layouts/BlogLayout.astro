<script is:inline>
  document.getElementById('year').textContent = new Date().getFullYear();

  (function () {
    var banner = document.getElementById('consent-banner');
    function readConsent() {
      try { return localStorage.getItem('bk-consent'); } catch (e) { return null; }
    }
    if (!readConsent()) banner.classList.add('show');
    function decide(state) {
      try { localStorage.setItem('bk-consent', state); } catch (e) { /* session-only choice */ }
      banner.classList.remove('show');
      gtag('consent', 'update', { analytics_storage: state === 'granted' ? 'granted' : 'denied' });
    }
    document.getElementById('consent-accept').addEventListener('click', function () { decide('granted'); });
    document.getElementById('consent-decline').addEventListener('click', function () { decide('denied'); });
    document.getElementById('cookie-settings').addEventListener('click', function (ev) {
      ev.preventDefault();
      try { localStorage.removeItem('bk-consent'); } catch (e) {}
      banner.classList.add('show');
    });
  })();

  (function () {
    var links = document.querySelectorAll('a[href^="http"]');
    for (var i = 0; i < links.length; i++) {
      if (links[i].hostname !== location.hostname) {
        links[i].target = '_blank';
        links[i].relList.add('noopener');
      }
    }
  })();

  document.addEventListener('click', function (ev) {
    var t = ev.target;
    var el = (t instanceof Element) ? t : (t && t.parentElement);
    var a = el && el.closest && el.closest('a[href]');
    if (!a) return;
    var loc = a.getAttribute('data-cta-loc') || 'other';
    // Every push sets BOTH parameter keys: dataLayer values persist
    // across pushes, so an unset key would reuse the previous event's
    // value in the shared GA4 tag.
    if (a.href.indexOf('wa.me') !== -1) {
      window.dataLayer.push({ event: 'whatsapp_click', cta_location: loc, method: undefined });
      window.posthog?.capture('whatsapp_contact_clicked', { cta_location: loc });
    } else if (a.href.indexOf('digitizer.li/schedule') !== -1) {
      window.dataLayer.push({ event: 'schedule_click', cta_location: loc, method: undefined });
      window.posthog?.capture('consultation_booking_clicked', { cta_location: loc });
    }
  });
</script>

